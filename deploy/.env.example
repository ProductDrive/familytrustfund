# Copy to `.env` next to docker-compose.yml, fill in real values, never commit.

# Docker network shared with the existing Traefik reverse proxy on the VPS.
# This stack runs no proxy of its own; the API containers must join the network
# the VPS Traefik is attached to. Find the exact name on the VPS with:
#   docker network ls --filter name=aspire
FTF_PROXY_NETWORK=drivesolution_aspire

# Production database
PROD_DB_USER=familytrustfund
PROD_DB_PASSWORD=change-me-strong-password
PROD_DB_NAME=familytrustfund

# Staging database (keep separate from prod)
STAGING_DB_USER=familytrustfund_staging
STAGING_DB_PASSWORD=change-me-strong-password
STAGING_DB_NAME=familytrustfund_staging

# Google OIDC (shared OAuth client).
# When the frontend is served from a different origin (Vercel) and calls the API
# through a same-origin rewrite, *_FRONTEND_URL below is also used as the OIDC
# redirect_uri, so register the FRONTEND callback URLs in the Google console:
#   https://familytrustfund.vercel.app/api/auth/google/callback
# plus each frontend's JavaScript origin, e.g.:
#   https://familytrustfund.vercel.app
# The API-host callbacks remain valid only when *_FRONTEND_URL is left empty:
#   https://ftf.drivesolution.cloud/api/auth/google/callback
#   https://ftf.staging.drivesolution.cloud/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend URLs (Vercel or custom domain). The authenticated user is redirected
# here after Google sign-in, and this origin becomes the OIDC redirect_uri.
PROD_FRONTEND_URL=https://familytrustfund.vercel.app
STAGING_FRONTEND_URL=https://familytrustfund.vercel.app

# Paystack. Use test keys until live funding is configured.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Passwordless email sign-in (primary auth). The Afe.PRD.Email.Sender "on
# behalf" sender is used for delivery; no SMTP credentials are needed here.
# Set Authentication__Otp__Enabled=true in the API environment to expose the
# /api/auth/otp endpoints. New Guarantor signups are held as Pending until a
# SuperAdmin approves them via POST /api/admin/guarantors/{userId}/approve.
AUTH_OTP_ENABLED=true
AUTH_TERMS_VERSION=1.0

# Initial SuperAdmin provisioning (seeding only runs for the Staging/Development
# environments; provision prod SuperAdmins through the running app).
STAGING_SUPERADMIN_EMAIL=admin@example.com

# Container images, published by .github/workflows/docker-build-publish.yml:
#   main    -> ghcr.io/<owner>/<repo>/ftfapi:latest
#   develop -> ghcr.io/<owner>/<repo>/ftfapi:staging
PROD_API_IMAGE=ghcr.io/your-org/familytrustfund/ftfapi:latest
STAGING_API_IMAGE=ghcr.io/your-org/familytrustfund/ftfapi:staging